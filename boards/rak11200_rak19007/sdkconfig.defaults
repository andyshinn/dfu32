# RAKwireless WisBlock RAK11200 core (ESP32-WROVER-B: 4 MB flash, 8 MB PSRAM) on
# a RAK19007 base board. A classic ESP32 maps only 4 MB of the PSRAM; IDF detects
# the chip size itself, maps the first 4 MB and logs a warning, so no extra PSRAM
# option is set (as for feather_esp32_v2). Classic ESP32,
# BLE 4.2 (DLE, no 2M PHY). Console on UART0 over the base board's USB-C.
# There is no auto-reset circuit: to flash, hold BOOT0 low (pull it to GND)
# while resetting the board.
# Pins verified against RAK's WisCore_RAK11200_Board variant, as carried in
# meshtastic/firmware variants/esp32/rak11200/pins_arduino.h.
CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/4mb.csv"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Classic ESP32: run the controller in BLE-only mode (no BR/EDR memory).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

CONFIG_DFU32_BOARD_NAME="rak11200_rak19007"
# No addressable LED on the core or the base board.
CONFIG_DFU32_NEOPIXEL_GPIO=-1
CONFIG_DFU32_NEOPIXEL_POWER_GPIO=-1
# Blue LED (WisBlock LED2). GPIO2 is a strapping pin, but it only matters when
# GPIO0 is also low (download mode), so a lit LED can't stop a normal boot.
# The green LED (LED1) is on GPIO12, the MTDI strapping pin that picks the
# flash voltage: driving it high across a reset could select 1.8 V for the
# WROVER-B's 3.3 V flash, so don't use it as an output.
CONFIG_DFU32_STATUS_LED_GPIO=2
# The RAK19007 has only a reset button. WB_SW1 (GPIO34) is a connector pin for
# IO modules, not a button on the base.
CONFIG_DFU32_BUTTON_GPIO=-1
