# RAKwireless WisBlock RAK11200 core (ESP32-WROVER-B: 4 MB flash, 8 MB PSRAM, of
# which a classic ESP32 maps 4 MB) on a RAK19007 base board. Classic ESP32,
# BLE 4.2 (DLE, no 2M PHY). Console on UART0 over the base board's USB-C.
# There is no auto-reset circuit: to flash, hold BOOT0 low (pull it to GND)
# while resetting the board.
# Pins verified against RAK's WisCore_RAK11200_Board variant, as carried in
# meshtastic/firmware variants/esp32/rak11200/pins_arduino.h.
CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/4mb.csv"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Classic ESP32: run the controller in BLE-only mode (no BR/EDR memory).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

CONFIG_DFU32_BOARD_NAME="rak11200_rak19007"
# No addressable LED on the core or the base board.
CONFIG_DFU32_NEOPIXEL_GPIO=-1
CONFIG_DFU32_NEOPIXEL_POWER_GPIO=-1
# Green LED (WisBlock LED1). The blue LED (LED2) is GPIO2. GPIO12 is the MTDI
# strapping pin that picks the flash voltage at reset: the LED's resistor to
# ground keeps it low, so never add a pull-up here.
CONFIG_DFU32_STATUS_LED_GPIO=12
# The RAK19007 has only a reset button. WB_SW1 (GPIO34) is a connector pin for
# IO modules, not a button on the base.
CONFIG_DFU32_BUTTON_GPIO=-1
