# Generic ESP32-S3 N16R8 DevKitC-1 clone (16 MB flash, 8 MB octal PSRAM).
# LED pin varies by clone (often an addressable LED on GPIO48 with no power pin):
# verify against your board and override with menuconfig if needed.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/8mb.csv"

CONFIG_SPIRAM_MODE_OCT=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=y

CONFIG_DFU32_BOARD_NAME="esp32s3_n16r8"
CONFIG_DFU32_NEOPIXEL_GPIO=48
CONFIG_DFU32_NEOPIXEL_POWER_GPIO=-1
CONFIG_DFU32_STATUS_LED_GPIO=-1
CONFIG_DFU32_BUTTON_GPIO=0
