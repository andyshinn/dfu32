# DFU32 common defaults (SPEC.md §12.3). Board specifics (target, flash size,
# partition CSV, PSRAM mode, console, pins) are in boards/<profile>/sdkconfig.defaults.

# ---- Partitions / app ----------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# C++ exceptions and RTTI stay at their IDF default (disabled).

# ---- Bluetooth (NimBLE) --------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Peripheral + broadcaster are only for Improv BLE while unprovisioned.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# >= PRN(8) x fragments + headroom; tune on the bench (M2).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32
# DFU32 never bonds (BT_NIMBLE_NVS_PERSIST stays at its default, off).
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ---- WiFi / lwIP: drop what DFU32 never uses (app size, SPEC.md §12.1) ---------
# Station only: no soft-AP. WPA2-Personal (and open) networks only: no
# WPA3-Personal (SAE), no WPA2/3-Enterprise (and its 192-bit GMAC suites), no
# OWE "enhanced open". WPA2/WPA3 transition-mode networks still connect over
# WPA2; WPA3-only networks don't. With SAE/OWE gone nothing calls mbedTLS's
# elliptic-curve code, so the linker drops it. ESP_WIFI_MBEDTLS_CRYPTO itself
# stays on: in IDF 6.1 the supplicant's built-in crypto doesn't link
# (undefined sha1_vector).
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_GMAC_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# IPv4 only: the API, manifest fetches, SNTP and mDNS all run over IPv4.
# CONFIG_LWIP_IPV6 is not set

# ---- Coexistence ---------------------------------------------------------------
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ---- PSRAM (required; mode set per board profile) -------------------------------
CONFIG_SPIRAM=y
# Refuse to boot on a board without PSRAM (SPIRAM_IGNORE_NOTFOUND stays off).
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Watchdogs -----------------------------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# ---- HTTP ----------------------------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# POST /api/v1/staging carries the .dat, version, board, SHA-256 and file name
# in its query (SPEC.md §10.1). httpd's scratch buffer is already the header
# length, so a URI limit up to it costs no extra RAM there.
CONFIG_HTTPD_MAX_URI_LEN=1024
# v1 is HTTP-only (SPEC.md §2, §11).
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set

# ---- JSON (espressif/cjson) ------------------------------------------------------
# Manifests and API bodies are flat; a low limit keeps a hostile document from
# recursing through the task stack. Must equal dfu32::json::kNestingLimit.
CONFIG_CJSON_NESTING_LIMIT=16

# ---- Logging -------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
